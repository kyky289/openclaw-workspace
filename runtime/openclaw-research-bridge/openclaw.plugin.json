{
  "id": "openclaw-research-bridge",
  "name": "Research Candidate Bridge",
  "description": "Local, test-only research candidates in explicitly authorized private and isolated group contexts. Disabled by default.",
  "version": "0.1.0",
  "activation": { "onStartup": true },
  "contracts": {
    "tools": ["research_task_submit", "research_task_get", "research_task_list", "research_task_propose"]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": { "type": "boolean", "default": false },
      "environment": { "type": "string", "enum": ["test"] },
      "stateDirectory": { "type": "string", "description": "Absolute dedicated private directory whose final name is research-bridge-test." },
      "allowedContexts": {
        "type": "array", "minItems": 1, "maxItems": 20,
        "items": {
          "type": "object", "additionalProperties": false,
          "required": ["sessionKey", "nativeChannelId", "requesterSenderId"],
          "properties": {
            "sessionKey": { "type": "string" },
            "nativeChannelId": { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" },
            "requesterSenderId": { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" }
          }
        }
      },
      "allowedGroupContexts": {
        "description": "Optional exact non-topic main Telegram groups, restricted to an owner already allowed for private research. Each group has isolated state.",
        "type": "array", "minItems": 1, "maxItems": 20,
        "items": {
          "type": "object", "additionalProperties": false,
          "required": ["sessionKey", "nativeChannelId", "requesterSenderId"],
          "properties": {
            "sessionKey": { "type": "string", "pattern": "^agent:main:telegram:group:-[1-9][0-9]{0,19}$" },
            "nativeChannelId": { "type": "string", "pattern": "^-[1-9][0-9]{0,19}$" },
            "requesterSenderId": { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" }
          }
        }
      },
      "allowedGroupCollaboratorContexts": {
        "description": "Optional exact non-owner collaborators in an already approved main Telegram group. Shared group research only; no private or owner permissions.",
        "type": "array", "minItems": 1, "maxItems": 20,
        "items": {
          "type": "object", "additionalProperties": false,
          "required": ["sessionKey", "nativeChannelId", "requesterSenderId"],
          "properties": {
            "sessionKey": { "type": "string", "pattern": "^agent:main:telegram:group:-[1-9][0-9]{0,19}$" },
            "nativeChannelId": { "type": "string", "pattern": "^-[1-9][0-9]{0,19}$" },
            "requesterSenderId": { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" }
          }
        }
      }
    }
  }
}
